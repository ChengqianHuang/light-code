#!/usr/bin/env bash
# Builds a self-contained Light Code .app for macOS without cargo-bundle.
# Requires a prior release build:
#   ZED_BUNDLE=true cargo --config .cargo/bundle-config.toml build --release --package zed

set -euo pipefail

APP_NAME="Light Code"
BUNDLE_ID="dev.lightcode.LightCode"
TARGET_DIR="target/release"
BUILD_ROOT="target/bundle-local"

binary="${TARGET_DIR}/zed"
if [[ ! -f "${binary}" ]]; then
    echo "release binary not found at ${binary}; run the release build first" >&2
    exit 1
fi

app_path="${BUILD_ROOT}/${APP_NAME}.app"
rm -rf "${app_path}"
mkdir -p "${app_path}/Contents/MacOS" "${app_path}/Contents/Resources"

cp "${binary}" "${app_path}/Contents/MacOS/zed"

# Application icon: build an .icns from the app icons via iconutil.
iconset_dir="${BUILD_ROOT}/app.iconset"
rm -rf "${iconset_dir}"
mkdir -p "${iconset_dir}"
for size in 16 32 128 256 512; do
    sips -z "${size}" "${size}" crates/zed/resources/app-icon.png \
        --out "${iconset_dir}/icon_${size}x${size}.png" > /dev/null
    double=$((size * 2))
    sips -z "${double}" "${double}" crates/zed/resources/app-icon@2x.png \
        --out "${iconset_dir}/icon_${size}x${size}@2x.png" > /dev/null
done
iconutil -c icns "${iconset_dir}" -o "${app_path}/Contents/Resources/AppIcon.icns"
rm -rf "${iconset_dir}"

cp crates/zed/resources/Document.icns "${app_path}/Contents/Resources/Document.icns"

# Info.plist: assembled from the bundle metadata and the shared
# resources/info/*.plist fragments used by the upstream bundle.
plist="${app_path}/Contents/Info.plist"
{
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    echo '<plist version="1.0">'
    echo '<dict>'
    echo '    <key>CFBundleDevelopmentRegion</key><string>en</string>'
    echo '    <key>CFBundleDisplayName</key><string>'"${APP_NAME}"'</string>'
    echo '    <key>CFBundleExecutable</key><string>zed</string>'
    echo '    <key>CFBundleIconFile</key><string>AppIcon</string>'
    echo '    <key>CFBundleIdentifier</key><string>'"${BUNDLE_ID}"'</string>'
    echo '    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>'
    echo '    <key>CFBundleName</key><string>'"${APP_NAME}"'</string>'
    echo '    <key>CFBundlePackageType</key><string>APPL</string>'
    echo '    <key>CFBundleShortVersionString</key><string>0.1.0</string>'
    echo '    <key>CFBundleVersion</key><string>1</string>'
    echo '    <key>LSMinimumSystemVersion</key><string>10.15.7</string>'
    echo '    <key>NSHighResolutionCapable</key><true/>'
    echo '    <key>NSSupportsAutomaticGraphicsSwitching</key><true/>'
    echo '    <key>NSPrincipalClass</key><string>NSApplication</string>'
    echo '    <key>NSSupportsAutomaticTermination</key><false/>'
    for ext in crates/zed/resources/info/*.plist; do
        echo "    <!-- ${ext} -->"
        cat "${ext}"
    done
    echo '    <key>CFBundleURLTypes</key>'
    echo '    <array>'
    echo '        <dict>'
    echo '            <key>CFBundleURLName</key><string>zed URL scheme</string>'
    echo '            <key>CFBundleURLSchemes</key>'
    echo '            <array><string>zed</string></array>'
    echo '        </dict>'
    echo '    </array>'
    echo '</dict>'
    echo '</plist>'
} > "${plist}"

plutil -lint "${plist}"

# Ad-hoc signature so macOS Gatekeeper launches the app without warnings.
codesign --force --deep --sign - "${app_path}"

echo "Bundled ${app_path}"
